#!/usr/bin/env bash
# systemd ExecStart 包装器：读取板端配置并以前台进程方式 exec socchina_app。
set -euo pipefail

readonly APP_DIR="${SOCCHINA_APP_DIR:-/root/socchina-2026}"
readonly APP="${APP_DIR}/socchina_app"
readonly CONFIG="${SOCCHINA_CONFIG:-/etc/socchina/runtime.conf}"
readonly MIPI_DEVICE="${SOCCHINA_MIPI_DEVICE:-/dev/ot_mipi_rx}"
readonly DEVICE_WAIT_SECONDS="${SOCCHINA_DEVICE_WAIT_SECONDS:-30}"

if [[ ! -x "${APP}" ]]; then
    echo "[socchina-start] executable not found: ${APP}" >&2
    exit 1
fi
if [[ ! -r "${CONFIG}" ]]; then
    echo "[socchina-start] config not readable: ${CONFIG}" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "${CONFIG}"

: "${ENABLE_HDMI:=0}"
: "${RTSP_PORT:=8554}"
: "${STREAM_PATH:=live}"
: "${BITRATE_KBPS:=3000}"
: "${SENSOR_INDEX:=1}"
: "${TONE_STRENGTH:=0.7}"

if [[ "${ENABLE_HDMI}" != "0" && "${ENABLE_HDMI}" != "1" ]]; then
    echo "[socchina-start] ENABLE_HDMI must be 0 or 1" >&2
    exit 2
fi
if [[ ! "${RTSP_PORT}" =~ ^[0-9]+$ ]] || ((RTSP_PORT < 1 || RTSP_PORT > 65535)); then
    echo "[socchina-start] invalid RTSP_PORT: ${RTSP_PORT}" >&2
    exit 2
fi
if [[ ! "${BITRATE_KBPS}" =~ ^[0-9]+$ ]] || ((BITRATE_KBPS < 128)); then
    echo "[socchina-start] invalid BITRATE_KBPS: ${BITRATE_KBPS}" >&2
    exit 2
fi
if [[ ! "${SENSOR_INDEX}" =~ ^[0-9]+$ ]]; then
    echo "[socchina-start] invalid SENSOR_INDEX: ${SENSOR_INDEX}" >&2
    exit 2
fi
if [[ ! "${STREAM_PATH}" =~ ^[A-Za-z0-9._~-]+$ ]]; then
    echo "[socchina-start] invalid STREAM_PATH: ${STREAM_PATH}" >&2
    exit 2
fi

for ((second = 0; second < DEVICE_WAIT_SECONDS; second++)); do
    [[ -e "${MIPI_DEVICE}" ]] && break
    if ((second == 0)); then
        echo "[socchina-start] waiting for ${MIPI_DEVICE} (up to ${DEVICE_WAIT_SECONDS}s)"
    fi
    sleep 1
done
if [[ ! -e "${MIPI_DEVICE}" ]]; then
    echo "[socchina-start] device did not appear: ${MIPI_DEVICE}" >&2
    exit 1
fi

args=(
    --stream
    --sensor "${SENSOR_INDEX}"
    --strength "${TONE_STRENGTH}"
    --bitrate "${BITRATE_KBPS}"
    --rtsp-port "${RTSP_PORT}"
    --stream-path "${STREAM_PATH}"
)
if [[ "${ENABLE_HDMI}" == "0" ]]; then
    args+=(--no-display)
fi

echo "[socchina-start] RTSP port=${RTSP_PORT} path=/${STREAM_PATH} bitrate=${BITRATE_KBPS}kbps HDMI=${ENABLE_HDMI}"
cd "${APP_DIR}"
exec stdbuf -oL -eL "${APP}" "${args[@]}"
